"""
Worker entry point for {{ agent_name }}.

Uses the generic AgentWorker class from core_agents for standardized
worker setup and command handling.

This module provides the CLI interface for running the agent:
- worker: Run as a Temporal worker
- check: Run a single analysis (for testing)
{% if schedule_type == 'scheduled' %}
- schedule: Start the scheduled workflow
{% endif %}
"""

import logging
{% if uses_temporal %}
from core_agents.worker import (
    AgentWorker,
    AgentWorkerConfig,
    CommandConfig,
{% if schedule_type == 'scheduled' %}
    ScheduledWorkflowConfig,
{% endif %}
)

from .activities import analyze_and_report{% if uses_discord %}, post_to_discord{% endif %}

from .workflows import AnalysisWorkflow{% if schedule_type == 'scheduled' %}, ScheduledWorkflow{% endif %}

{% endif %}
from .agent import run_analysis

logger = logging.getLogger(__name__)


{% if uses_temporal %}
async def handle_check(_worker: AgentWorker) -> None:
    """Handle 'check' command - run a single analysis."""
    result = await _worker.run_single_workflow(
        AnalysisWorkflow,
        "{{ agent_name }}-check",
    )
    print("\n" + "=" * 60)
    print("Analysis Result")
    print("=" * 60)
    print(result)
    print("=" * 60 + "\n")


def create_worker() -> AgentWorker:
    """Create the {{ agent_name }} worker."""
    config = AgentWorkerConfig(
        task_queue="{{ agent_name }}",
        name="{{ agent_name }}",
        description="{{ description }}",
        workflows=[
            AnalysisWorkflow,
{% if schedule_type == 'scheduled' %}
            ScheduledWorkflow,
{% endif %}
        ],
        activities=[
            analyze_and_report,
{% if uses_discord %}
            post_to_discord,
{% endif %}
        ],
{% if schedule_type == 'scheduled' %}
        scheduled_workflows=[
            ScheduledWorkflowConfig(
                workflow_class=ScheduledWorkflow,
                workflow_id="{{ agent_name }}-scheduled",
                default_interval_hours={{ schedule_interval_hours }},
                interval_env_var="SCHEDULE_INTERVAL_HOURS",
            ),
        ],
{% endif %}
        custom_commands=[
            CommandConfig(
                name="check",
                description="Run single analysis (testing)",
                handler=handle_check,
            ),
        ],
    )
    return AgentWorker(config)


def main() -> None:
    """Main entry point."""
    worker = create_worker()
    worker.run()
{% else %}

def run_check() -> None:
    """Run a single analysis check (for testing)."""
    logger.info("Running single analysis check")

    result = run_analysis()

    print("\n" + "=" * 60)
    print("Analysis Result")
    print("=" * 60)
    print(result)
    print("=" * 60 + "\n")


def main() -> None:
    """Main entry point."""
    import sys
    command = sys.argv[1] if len(sys.argv) > 1 else "check"

    if command == "check":
        run_check()
    else:
        print(f"Unknown command: {command}")
        print("Usage: {{ package_name }}-worker [check]")
        sys.exit(1)
{% endif %}


if __name__ == "__main__":
    main()
