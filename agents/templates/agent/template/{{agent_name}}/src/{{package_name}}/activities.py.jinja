{% if uses_temporal %}

import logging
import os
from datetime import UTC, datetime
from typing import Any

{% if uses_discord %}
import httpx
{% endif %}
from temporalio import activity

from .agent import run_analysis
from .models import Result, Status{% if uses_discord %}, DiscordPostResult{% endif %}


logger = logging.getLogger(__name__)


def _determine_status(summary: str) -> Status:
    """Determine status from summary content."""
    summary_lower = summary.lower()

    if any(word in summary_lower for word in ["critical", "failed", "error", "down"]):
        return Status.CRITICAL
    if any(word in summary_lower for word in ["warning", "pending", "degraded"]):
        return Status.WARNING
    return Status.HEALTHY


@activity.defn
async def analyze_and_report() -> dict[str, Any]:
    """
    Run analysis and return the result.

    Returns:
        Result dictionary with analysis data.
    """
    logger.info("Starting analysis")

    try:
        summary = run_analysis()
        status = _determine_status(summary)

        logger.info(f"Analysis complete with status: {status.value}")

        return Result(
            summary=summary,
            status=status,
            timestamp=datetime.now(UTC).isoformat(),
        ).model_dump()

    except Exception as e:
        logger.exception("Error during analysis")
        return Result(
            summary="",
            status=Status.ERROR,
            timestamp=datetime.now(UTC).isoformat(),
            error=str(e),
        ).model_dump()

{% if uses_discord %}

# Discord embed colors
STATUS_COLORS: dict[Status, int] = {
    Status.HEALTHY: 0x57F287,  # Green
    Status.WARNING: 0xFEE75C,  # Yellow
    Status.CRITICAL: 0xED4245,  # Red
    Status.ERROR: 0x99AAB5,  # Gray
}

STATUS_EMOJI: dict[Status, str] = {
    Status.HEALTHY: "✅",
    Status.WARNING: "⚠️",
    Status.CRITICAL: "🚨",
    Status.ERROR: "❌",
}


@activity.defn
async def post_to_discord(result: dict[str, Any]) -> dict[str, Any]:
    """
    Post the result to Discord.

    Args:
        result: The Result dictionary to post.

    Returns:
        DiscordPostResult dictionary.
    """
    webhook_url = os.environ.get("DISCORD_WEBHOOK_URL")
    if not webhook_url:
        logger.error("DISCORD_WEBHOOK_URL not configured")
        return DiscordPostResult(
            success=False,
            error="DISCORD_WEBHOOK_URL not set",
        ).model_dump()

    status = Status(result.get("status", "error"))
    emoji = STATUS_EMOJI.get(status, "📊")
    color = STATUS_COLORS.get(status, 0x5865F2)

    embed = {
        "title": f"{emoji} {{ agent_name }} Report",
        "description": result.get("summary", "No summary")[:4000],
        "color": color,
        "footer": {"text": f"{{ agent_name }} • {result.get('timestamp', '')}"},
    }

    if result.get("error"):
        embed["fields"] = [
            {
                "name": "Error",
                "value": f"```{result['error'][:1000]}```",
                "inline": False,
            }
        ]

    payload = {
        "username": "{{ agent_name }}",
        "embeds": [embed],
    }

    try:
        async with httpx.AsyncClient(timeout=30.0) as client:
            response = await client.post(webhook_url, json=payload)
            response.raise_for_status()

        logger.info("Successfully posted to Discord")
        return DiscordPostResult(success=True).model_dump()

    except Exception as e:
        logger.exception("Error posting to Discord")
        return DiscordPostResult(success=False, error=str(e)).model_dump()
