VERSION 0.8

# =============================================================================
# k8s-monitor Agent Build
# =============================================================================
# Kubernetes cluster health monitoring agent with AI-powered analysis
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=v0.1.0       # Build with specific version
#   earthly +test                          # Run tests
#   earthly +lint                          # Run linting
#   earthly --push +push                   # Push to registry
#   earthly --push +push --VERSION=main-abc123  # Push with version tag
# =============================================================================

# Import from root Earthfile and core-agents
IMPORT ../.. AS root
IMPORT ../core AS core

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=k8s-monitor
ARG --global VERSION=latest
ARG --global CORE_AGENTS_VERSION=latest

# =============================================================================
# Core Agents Dependency
# =============================================================================

# Fetch core-agents wheel from registry (production)
core-agents-from-registry:
    FROM alpine:3.19

    # Install oras CLI for OCI artifact pull
    RUN apk add --no-cache curl tar && \
        curl -LO https://github.com/oras-project/oras/releases/download/v1.2.0/oras_1.2.0_linux_amd64.tar.gz && \
        tar -xzf oras_1.2.0_linux_amd64.tar.gz -C /usr/local/bin oras && \
        rm oras_1.2.0_linux_amd64.tar.gz

    WORKDIR /wheels

    # Pull wheel from registry
    RUN --no-cache oras pull ${REGISTRY}/python/core-agents:${CORE_AGENTS_VERSION} 2>/dev/null || \
        echo "INFO: core-agents not in registry, will use local build"

    SAVE ARTIFACT /wheels/*.whl /wheel/ IF_EXISTS

# =============================================================================
# Dependencies
# =============================================================================

# Install Python dependencies
deps:
    FROM root+python-k8s-base

    # Copy core-agents wheel (built locally from ../core)
    COPY core+wheel/wheel/*.whl /tmp/wheels/

    # Install core-agents from wheel
    RUN pip install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels

    # Copy project files for dependency resolution
    COPY pyproject.toml README.md /app/

    # Install dependencies (skip core-agents since already installed)
    RUN pip install --no-cache-dir -e ".[dev]"

    SAVE IMAGE --cache-hint

# =============================================================================
# Source Code
# =============================================================================

# Copy source code
src:
    FROM +deps

    # Copy source
    COPY --chown=agent:agent src/ /app/src/

    # Set Python path to include src directory
    ENV PYTHONPATH=/app/src:/app

    SAVE IMAGE --cache-hint

# =============================================================================
# Testing
# =============================================================================

# Run tests
test:
    FROM +src

    # Copy test files
    COPY --chown=agent:agent tests/ /app/tests/

    # Run pytest with coverage
    RUN pytest \
        --cov=k8s_monitor \
        --cov-report=term-missing \
        --cov-report=xml:coverage.xml \
        -v

    # Save coverage report
    SAVE ARTIFACT coverage.xml AS LOCAL coverage.xml

# Run linting
lint:
    FROM +src

    # Copy test files for linting
    COPY --chown=agent:agent tests/ /app/tests/

    # Run ruff check
    RUN ruff check src/ tests/

    # Run ruff format check
    RUN ruff format --check src/ tests/

    # Run mypy (allow failures for now)
    RUN mypy src/ || true

# =============================================================================
# Docker Image
# =============================================================================

# Build production Docker image
docker:
    FROM root+python-k8s-base

    # Copy core-agents wheel (built locally from ../core)
    COPY core+wheel/wheel/*.whl /tmp/wheels/

    # Install core-agents from wheel
    RUN pip install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels

    # Copy project files
    COPY --chown=agent:agent pyproject.toml README.md /app/

    # Copy source
    COPY --chown=agent:agent src/ /app/src/

    # Install production dependencies only
    RUN pip install --no-cache-dir .

    # Set environment
    ENV PYTHONPATH=/app/src:/app

    # Switch to non-root user
    USER agent

    # Entry point
    ENTRYPOINT ["python", "-m", "k8s_monitor.worker"]
    CMD ["worker"]

    # Build metadata
    LABEL org.opencontainers.image.title="k8s-monitor"
    LABEL org.opencontainers.image.description="Kubernetes cluster health monitoring agent"
    LABEL org.opencontainers.image.version="${VERSION}"
    LABEL org.opencontainers.image.source="https://github.com/X-McKay/kubani"

    # Save image locally (both versioned and latest)
    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# Push to registry (single platform for speed, use +push-multi for multi-arch)
push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END

# Push to registry (multi-platform) - slower but supports arm64
push-multi:
    BUILD --platform=linux/amd64 --platform=linux/arm64 +docker-push

# Internal target for multi-platform pushing
docker-push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Development Helpers
# =============================================================================

# Interactive shell for development
dev:
    FROM +src
    COPY --chown=agent:agent tests/ /app/tests/
    RUN --interactive /bin/bash

# Run the worker locally (for testing)
run:
    FROM +docker
    RUN --entrypoint python -m k8s_monitor.worker check
