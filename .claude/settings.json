{
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(just *:*)",
      "Bash(uv:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(git:*)",
      "Bash(git add:*)",
      "Bash(git rev-parse:*)",
      "Bash(git -C /home/al/git/kubani *:*)",
      "Bash(git -C /home/al/git/kubani-infra-focus *:*)",
      "Bash(kubectl:*)",
      "Bash(*kubectl *:*)",
      "Bash(flux:*)",
      "Bash(*flux *:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-inventory:*)",
      "Bash(ansible-galaxy:*)",
      "Bash(ansible-lint:*)",
      "Bash(tailscale:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(touch:*)",
      "Bash(rmdir:*)",
      "Bash(curl:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(source:*)",
      "Bash(systemctl status:*)",
      "Bash(SOPS_AGE_KEY_FILE=age.key sops:*)",
      "Bash(claude mcp *:*)",
      "Bash(xargs *:*)",
      "Bash(temporal *:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Read(*)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(infrastructure/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(infrastructure/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:fluxcd.io)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:docs.ansible.com)",
      "WebFetch(domain:longhorn.io)",
      "WebFetch(domain:cert-manager.io)",
      "Skill(*:*)",
      "Skill(superpowers:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(git push --force * main)",
      "Bash(git push --force * master)",
      "Bash(git push -f * main)",
      "Bash(git push -f * master)",
      "Write(age.key)",
      "Write(*.agekey)",
      "Write(.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/permission-gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
