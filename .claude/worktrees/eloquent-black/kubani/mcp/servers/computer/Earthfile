VERSION 0.8

# =============================================================================
# Computer Use MCP Server Build
# =============================================================================
# MCP server for browser control via Playwright with Xvfb + noVNC
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=0.1.0        # Build with specific version
#   earthly --push +push --VERSION=0.1.0   # Build and push to registry
# =============================================================================

# Import from kubani root
IMPORT ../../../.. AS root
IMPORT ../../.. AS kubani

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=computer-mcp-server
ARG --global VERSION=latest

# =============================================================================
# Docker Image
# =============================================================================

docker:
    FROM python:3.13-slim

    # Install system dependencies (xvfb, vnc, novnc for headless browser)
    RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        curl \
        && rm -rf /var/lib/apt/lists/*

    WORKDIR /app

    # Install uv system-wide
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
        mv /root/.local/bin/uv /usr/local/bin/uv && \
        mv /root/.local/bin/uvx /usr/local/bin/uvx
    ENV PATH="/usr/local/bin:$PATH"

    # Copy workspace root files
    COPY root+root-files/pyproject.toml /app/pyproject.toml
    COPY root+root-files/README.md /app/README.md

    # Copy kubani package (framework)
    COPY kubani+src/__init__.py /app/kubani/__init__.py
    COPY kubani+src/framework /app/kubani/framework

    # Create MCP servers directory structure
    RUN mkdir -p /app/kubani/mcp/servers/computer

    # Copy this MCP server
    COPY pyproject.toml /app/kubani/mcp/servers/computer/pyproject.toml
    COPY src /app/kubani/mcp/servers/computer/src

    # Update workspace to include this MCP server
    RUN python3 -c "
import re
with open('/app/pyproject.toml', 'r') as f:
    content = f.read()
# Replace the members list with just this MCP server
content = re.sub(
    r'(\[tool\.uv\.workspace\])\s*members\s*=\s*\[[^\]]*\]',
    r'\1\nmembers = [\"kubani/mcp/servers/computer\"]',
    content
)
with open('/app/pyproject.toml', 'w') as f:
    f.write(content)
"

    # Install dependencies
    RUN uv sync --package computer-mcp-server --no-dev

    # Install Playwright Chromium with system deps
    RUN /app/.venv/bin/playwright install chromium --with-deps

    # Copy startup script
    COPY start.sh /app/start.sh
    RUN chmod +x /app/start.sh

    EXPOSE 8086 6080

    ENTRYPOINT ["/app/start.sh"]

    # Labels
    LABEL org.opencontainers.image.title="computer-mcp-server"
    LABEL org.opencontainers.image.description="Computer Use MCP server for Kubani"
    LABEL org.opencontainers.image.version="${VERSION}"

    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Push
# =============================================================================

push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END
