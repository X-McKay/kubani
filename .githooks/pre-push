#!/bin/bash

set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        REPO_ROOT="$(git rev-parse --show-toplevel)"

        echo ""
        echo "Running GitOps validation before push to main..."
        echo ""

        if ! command -v just >/dev/null 2>&1; then
            echo "just is not installed; skipping validation"
            exit 0
        fi

        if (cd "$REPO_ROOT" && just validate-gitops-build); then
            echo ""
            echo "GitOps validation passed"
        else
            echo ""
            echo "GitOps validation failed. Push blocked."
            echo "Use 'git push --no-verify' only if you intend to bypass the local check."
            exit 1
        fi

        echo ""
        break
    fi
done
