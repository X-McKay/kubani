# =============================================================================
# Nexus Local Development Environment
# =============================================================================
# Copy this file to .env.nexus-local.override and fill in secrets.
# The runner (scripts/nexus_local_runner.py) loads this file automatically.
#
# This configuration points ALL services at the live cluster ingress URLs
# (*.almckay.io) so you can iterate on code locally without building or
# pushing a container image.
#
# NEVER commit .env.nexus-local.override — it is gitignored.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM — cluster vLLM (Qwen3-14B-FP4 via almckay.io ingress)
# ---------------------------------------------------------------------------
LLM_PROVIDER=vllm
LLM_API_URL=https://llm.almckay.io/v1
LLM_MODEL=nvidia/Qwen3-14B-FP4
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120.0

# To use the fast/smaller model instead:
# LLM_API_URL=https://llm-fast.almckay.io/v1
# LLM_MODEL=nvidia/Qwen3-4B-FP4

# ---------------------------------------------------------------------------
# Temporal — cluster Temporal via almckay.io ingress (gRPC-web)
# ---------------------------------------------------------------------------
TEMPORAL_HOST=temporal.almckay.io:7233
TEMPORAL_NAMESPACE=nexus
TEMPORAL_TASK_QUEUE=nexus-orchestrator

# ---------------------------------------------------------------------------
# Database — cluster PostgreSQL (connection string from cluster secret)
# Fill in NEXUS_DATABASE_URL from: kubectl get secret nexus-config -n nexus -o jsonpath='{.data.nexus-database-url}' | base64 -d
# ---------------------------------------------------------------------------
NEXUS_DATABASE_URL=postgresql://kubani:CHANGE_ME@metadata.almckay.io:5432/kubani_nexus

# ---------------------------------------------------------------------------
# Redis — cluster Redis via almckay.io ingress
# Fill in REDIS_URL from: kubectl get secret nexus-config -n nexus -o jsonpath='{.data.redis-url}' | base64 -d
# ---------------------------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME@metadata.almckay.io:6379/0

# ---------------------------------------------------------------------------
# MCP Servers — cluster MCP servers via almckay.io ingress
# ---------------------------------------------------------------------------

# nexus policy (default — safe for reactive agent turns)
MCP_MEMORY_URL=https://mcp-gateway.almckay.io/memory
MCP_MEMORY_ENABLED=true

MCP_SKILLS_URL=https://skills-mcp.almckay.io
MCP_SKILLS_ENABLED=true

# nexus-proactive policy (adds cluster-facing servers for missions)
MCP_DISCORD_URL=https://discord-mcp.almckay.io
MCP_DISCORD_ENABLED=true

MCP_TEMPORAL_URL=https://mcp-gateway.almckay.io/temporal
MCP_TEMPORAL_ENABLED=true

# Kubernetes MCP is always stdio/npx — no URL needed
# MCP_KUBERNETES_ENABLED=true  # set to true to enable in nexus-proactive runs

# ---------------------------------------------------------------------------
# Memory / Vector DB — cluster Qdrant via almckay.io ingress
# ---------------------------------------------------------------------------
QDRANT_URL=https://qdrant.almckay.io
QDRANT_API_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Neo4j — cluster Neo4j via almckay.io ingress
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j.almckay.io:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG
KUBANI_ENVIRONMENT=development
