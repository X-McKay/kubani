# Kubani Development Environment Configuration
# =============================================
# Copy this file to .env to use external cluster services for local development.
#
# Prerequisites:
#   - Connected to Tailscale network
#   - DNS resolves *.almckay.io to cluster
#
# Usage:
#   cp .env.development .env
#   just dev k8s-monitor
#
# Or for agent-specific development:
#   cp .env.development agents/k8s-monitor/.env
#   cd agents/k8s-monitor && uv run python -m k8s_monitor.worker

# =============================================================================
# LLM Configuration (vLLM)
# =============================================================================
KUBANI_VLLM_API_URL=https://llm.almckay.io/v1
KUBANI_DEFAULT_MODEL_ID=nvidia/Qwen3-14B-FP4
KUBANI_MODEL_TEMPERATURE=0.3
KUBANI_MODEL_MAX_TOKENS=4096

# Legacy env var (used by some memory.py files)
VLLM_API_URL=https://llm.almckay.io/v1
VLLM_MODEL=nvidia/Qwen3-14B-FP4

# =============================================================================
# Embeddings Configuration
# =============================================================================
KUBANI_EMBEDDINGS_API_URL=https://embeddings.almckay.io/v1
KUBANI_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
KUBANI_EMBEDDINGS_DIMENSIONS=1024

# Legacy env var
EMBEDDINGS_API_URL=https://embeddings.almckay.io/v1
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
KUBANI_QDRANT_URL=https://qdrant.almckay.io
# Get from: kubectl get secret -n database qdrant-credentials -o jsonpath='{.data.api-key}' | base64 -d
KUBANI_QDRANT_API_KEY=

# Legacy env vars
QDRANT_HOST=qdrant.almckay.io
QDRANT_PORT=443
QDRANT_USE_HTTPS=true
# Get from: kubectl get secret -n database qdrant-credentials -o jsonpath='{.data.api-key}' | base64 -d
QDRANT_API_KEY=

# =============================================================================
# Graph Database (Neo4j)
# =============================================================================
KUBANI_NEO4J_URL=bolt://neo4j.almckay.io:7687
KUBANI_NEO4J_USERNAME=neo4j
# Get from: kubectl get secret -n database neo4j-credentials -o jsonpath='{.data.password}' | base64 -d
KUBANI_NEO4J_PASSWORD=

# Legacy env vars
NEO4J_URL=bolt://neo4j.almckay.io:7687
NEO4J_USERNAME=neo4j
# Get from: kubectl get secret -n database neo4j-credentials -o jsonpath='{.data.password}' | base64 -d
NEO4J_PASSWORD=

# =============================================================================
# Cache (Redis)
# =============================================================================
KUBANI_REDIS_URL=redis://redis.almckay.io:6379
# Get from: kubectl get secret -n cache redis-credentials -o jsonpath='{.data.redis-password}' | base64 -d
REDIS_PASSWORD=

# Legacy env vars
REDIS_HOST=redis.almckay.io
REDIS_PORT=6379

# =============================================================================
# Temporal Workflow Orchestration
# =============================================================================
# gRPC endpoint for workflow execution (requires Traefik TCP routing)
KUBANI_TEMPORAL_URL=temporal.almckay.io:7233
KUBANI_TEMPORAL_NAMESPACE=default

# Legacy env vars
TEMPORAL_HOST=temporal.almckay.io:7233
TEMPORAL_NAMESPACE=default

# Temporal CLI
TEMPORAL_ADDRESS=temporal.almckay.io:7233

# =============================================================================
# Metadata Registry
# =============================================================================
KUBANI_REGISTRY_URL=https://metadata.almckay.io
KUBANI_REGISTRY_ENABLED=true
KUBANI_REGISTRY_HEARTBEAT_INTERVAL=30

# =============================================================================
# Kubernetes MCP Server
# =============================================================================
# MCP server is accessible via Tailscale at kubernetes-mcp.almckay.io
# This works for local development, in-cluster, and Claude Code integration
KUBERNETES_MCP_SERVER_URL=https://kubernetes-mcp.almckay.io

# Alternative: Use local sidecar (uncomment if running locally)
# KUBERNETES_MCP_SERVER_URL=http://localhost:8080

# =============================================================================
# MCP Registry (Server Discovery)
# =============================================================================
# Local registry file for development (auto-discovered from ./mcp/registry.json)
# Uncomment to explicitly set the registry path:
# MCP_REGISTRY_FILE=./mcp/registry.json

# =============================================================================
# Observability
# =============================================================================
KUBANI_LOG_LEVEL=DEBUG
KUBANI_ENABLE_DEBUG_HOOKS=true

# =============================================================================
# Kubernetes Access
# =============================================================================
KUBECONFIG=${HOME}/.kube/config

# =============================================================================
# Discord Webhooks (Optional)
# =============================================================================
# Uncomment and set these if you want Discord notifications locally
# KUBANI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# KUBANI_DISCORD_APPROVAL_WEBHOOK_URL=https://discord.com/api/webhooks/...
