{
  "name": "discord-mcp-server",
  "description": "Bidirectional Discord integration for AI agents - send/read messages, manage reactions, channels, and webhooks",
  "transport": "sse",
  "url": "https://discord-mcp.almckay.io/sse",
  "capabilities": [
    "messages.send",
    "messages.read",
    "messages.delete",
    "messages.await_reply",
    "reactions.add",
    "reactions.remove",
    "reactions.get",
    "reactions.await",
    "channels.list",
    "channels.create",
    "channels.delete",
    "webhooks.list",
    "webhooks.create",
    "webhooks.delete"
  ],
  "readOnly": false
}
