FROM node:22-alpine

WORKDIR /app

# Copy pre-built dist and a minimal package.json
COPY dist ./dist

# Create a minimal package.json with just express
RUN echo '{"type":"module","dependencies":{"express":"^4.21.0"}}' > package.json

# Install express (v4 which is compatible)
RUN npm install --legacy-peer-deps 2>/dev/null || npm install

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "dist/index.js"]
