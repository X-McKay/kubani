VERSION 0.8

FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

deps:
    COPY package.json ./
    RUN pnpm install
    SAVE ARTIFACT node_modules

build:
    FROM +deps
    COPY . .
    RUN pnpm build
    SAVE ARTIFACT dist

docker:
    FROM node:22-alpine
    WORKDIR /app

    # Install pnpm for production
    RUN corepack enable && corepack prepare pnpm@latest --activate

    COPY package.json ./
    RUN pnpm install --prod

    COPY +build/dist ./dist

    ENV NODE_ENV=production
    ENV PORT=3000

    EXPOSE 3000

    ARG VERSION=latest
    SAVE IMAGE --push registry.almckay.io/kubani-ui:${VERSION}
    SAVE IMAGE --push registry.almckay.io/kubani-ui:latest
