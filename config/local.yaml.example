# Local Development Configuration
# ================================
# Copy to config/local.yaml (gitignored) and adjust as needed.
# These URLs point to cluster services via Tailscale/egress,
# allowing you to develop locally while using real cluster services.
#
# Config loading order (later overrides earlier):
#   1. config/default.yaml     (base defaults, committed)
#   2. config/{env}.yaml       (environment-specific, committed)
#   3. config/local.yaml       (local overrides, gitignored)
#   4. Environment variables   (KUBANI_ prefix with __ nesting)

environment: development
log_level: DEBUG

# =============================================================================
# Temporal Configuration
# =============================================================================
temporal:
  host: temporal.almckay.io:7233
  namespace: default
  task_queue: kubani-tasks
  enabled: true
  ui_url: https://temporal.almckay.io

# =============================================================================
# Memory Configuration
# =============================================================================
memory:
  qdrant:
    host: qdrant.almckay.io
    port: 443
    prefer_grpc: false  # Use REST via ingress
    # api_key: set via KUBANI_MEMORY__QDRANT__API_KEY env var
  neo4j:
    uri: bolt://neo4j.almckay.io:7687
    user: neo4j
    # password: set via KUBANI_MEMORY__NEO4J__PASSWORD env var
  redis:
    host: redis.almckay.io
    port: 6379
    # password: set via KUBANI_MEMORY__REDIS__PASSWORD env var

# =============================================================================
# LLM Configuration
# =============================================================================
llm:
  api_url: https://llm.almckay.io/v1
  model: Qwen3.5-9B-NVFP4

embeddings:
  api_url: https://embeddings.almckay.io/v1

# =============================================================================
# MCP Server URLs (cluster-deployed via egress)
# =============================================================================
mcp:
  temporal_url: https://temporal-mcp.almckay.io
  qdrant_url: https://qdrant-mcp.almckay.io
  memory_url: https://memory-mcp.almckay.io
  discord_url: https://discord-mcp.almckay.io
  discord_enabled: true
  registry_url: https://metadata.almckay.io
  registry_enabled: true

# =============================================================================
# Registry Configuration
# =============================================================================
registry:
  url: https://metadata.almckay.io

# =============================================================================
# Discord Configuration
# =============================================================================
discord:
  # bot_token: set via KUBANI_DISCORD__BOT_TOKEN env var
  # guild_id: set via KUBANI_DISCORD__GUILD_ID env var
  # Channel IDs - set these to your server's channel IDs
  alerts_channel: ""
  digest_channel: ""
  breaking_news_channel: ""
  learning_channel: ""
  approvals_channel: ""
  evaluations_channel: ""

# =============================================================================
# Local Development Settings
# =============================================================================
local_dev:
  enabled: true
  output_mode: console
  hot_reload: true
