        "ingresses",
        "ingresses/status",
        "networkpolicies"
      ],
      "verbs": [
        "get",
        "list",
        "watch"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaims"
      ],
      "verbs": [
