    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaims"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaims"
      ],
      "verbs": [
        "watch"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaims/status"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaims/status"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaims/status"
      ],
      "verbs": [
        "watch"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaimtemplates"
      ],
      "verbs": [
        "get"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaimtemplates"
      ],
      "verbs": [
        "list"
      ]
    },
    {
      "apiGroups": [
        "resource.k8s.io"
      ],
      "resources": [
        "resourceclaimtemplates"
      ],
      "verbs": [
        "watch"
      ]
    },
