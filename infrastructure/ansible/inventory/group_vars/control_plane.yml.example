---
# Variables specific to control plane nodes
# Copy this file to control_plane.yml and customize for your environment

# K3s server configuration is rendered from the k3s_control_plane role template.
# Add first-class role variables there rather than passing raw install-script
# arguments from inventory.

# API server configuration
api_server_port: 6443

# Backup configuration
backup_enabled: true
backup_schedule: "0 2 * * *"  # Daily at 2 AM
backup_retention_days: 7
