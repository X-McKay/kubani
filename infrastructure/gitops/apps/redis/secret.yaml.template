---
# This is a template for the Redis credentials secret.
# DO NOT commit this file with real credentials!
# To create the encrypted secret, fill this in outside the repository as a file
# named secret.enc.yaml, then run:
#   SOPS_AGE_KEY_FILE=age.key sops --encrypt <staged>/secret.enc.yaml > secret.enc.yaml
# Delete the plaintext afterwards and commit only secret.enc.yaml.
# See docs/infrastructure/configuration/secrets.md.

apiVersion: v1
kind: Secret
metadata:
  name: redis-credentials
  namespace: cache
type: Opaque
stringData:
  redis-password: "REPLACE_WITH_SECURE_PASSWORD"
