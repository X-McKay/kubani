{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "starbase2-github-api",
        "namespace": "starbase2-prod",
        "labels": {
          "app.kubernetes.io/name": "starbase2",
          "starbase2.io/installation": "starbase2-prod"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "starbase2",
            "starbase2.io/installation": "starbase2-prod"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "140.82.112.6/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 443
              }
            ]
          }
        ]
      }
    }
  ]
}
