# Inert template: no old runner image is safe for governed queues.
# Render only with the published new-source RepoDigest; replicas stay zero.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: session-runner-tenant-test-governed-v1-__BUILD_ID__
  namespace: agent-platform
  labels:
    app.kubernetes.io/name: session-runner-governed
    agentplatform.io/tenant: tenant-test
    agentplatform.io/worker-role: sessions
    agentplatform.io/worker-pool: governed-v1
    agentplatform.io/build-id: __BUILD_ID__
    app.kubernetes.io/part-of: agent-platform
  annotations:
    reloader.stakater.com/auto: 'true'
    agentplatform.io/source-commit: __SOURCE_COMMIT__
spec:
  replicas: 0
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: session-runner-governed
      agentplatform.io/tenant: tenant-test
      agentplatform.io/worker-role: sessions
      agentplatform.io/worker-pool: governed-v1
      agentplatform.io/build-id: __BUILD_ID__
  template:
    metadata:
      labels:
        app.kubernetes.io/name: session-runner-governed
        agentplatform.io/tenant: tenant-test
        agentplatform.io/worker-role: sessions
        agentplatform.io/worker-pool: governed-v1
        agentplatform.io/build-id: __BUILD_ID__
        app.kubernetes.io/part-of: agent-platform
    spec:
      serviceAccountName: session-runner
      automountServiceAccountToken: true
      enableServiceLinks: false
      terminationGracePeriodSeconds: 60
      nodeSelector:
        topology.kubani.io/role: database
      securityContext:
        runAsNonRoot: true
        runAsUser: 1600
        runAsGroup: 1600
        fsGroup: 1600
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: runner
        image: __RUNNER_IMAGE__
        args:
        - --role
        - sessions
        - --tenant
        - tenant-test
        env:
        - name: TENANT
          value: tenant-test
        - name: APS_URL
          value: http://agent-policy-service.agent-platform.svc.cluster.local:9002
        - name: APS_TOKEN_PATH
          value: /var/run/secrets/agent-policy-service/token
        - name: TEMPORAL_ADDRESS
          value: temporal-mtls.temporal.svc.cluster.local:7233
        - name: TEMPORAL_NAMESPACE
          value: agents-tenant-test
        - name: TEMPORAL_TLS_CERT
          value: /etc/temporal-tls/tls.crt
        - name: TEMPORAL_TLS_KEY
          value: /etc/temporal-tls/tls.key
        - name: TEMPORAL_TLS_CA
          value: /etc/temporal-tls/ca.crt
        - name: PAYLOAD_KEY_FILE
          value: /etc/agent-platform/payload-key/tenant-test
        - name: ARTIFACT_DIR
          value: /var/lib/agent-artifacts
        - name: WORKER_DEPLOYMENT
          value: session-runner-tenant-test-governed-v1
        - name: WORKER_BUILD_ID
          value: __BUILD_ID__
        - name: WORKER_POOL
          value: governed-v1
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: '1'
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          runAsNonRoot: true
          readOnlyRootFilesystem: true
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - name: aps-token
          mountPath: /var/run/secrets/agent-policy-service
          readOnly: true
        - name: temporal-tls
          mountPath: /etc/temporal-tls
          readOnly: true
        - name: payload-key
          mountPath: /etc/agent-platform/payload-key
          readOnly: true
        - name: artifacts
          mountPath: /var/lib/agent-artifacts
        - name: tmp
          mountPath: /tmp
      volumes:
      - name: aps-token
        projected:
          sources:
          - serviceAccountToken:
              audience: agent-policy-service
              expirationSeconds: 600
              path: token
      - name: temporal-tls
        secret:
          secretName: session-runner-temporal-tls
      - name: payload-key
        secret:
          secretName: session-payload-key-tenant-test
          items:
          - key: key
            path: tenant-test
      - name: tmp
        emptyDir:
          sizeLimit: 256Mi
      - name: artifacts
        persistentVolumeClaim:
          claimName: agent-artifacts-tenant-test
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                app.kubernetes.io/name: session-runner
                agentplatform.io/tenant: tenant-test
            topologyKey: kubernetes.io/hostname
