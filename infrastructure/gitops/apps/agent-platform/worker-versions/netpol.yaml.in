# Inactive additions; preserve legacy policies, do not broaden old selectors.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: governed-sessions-egress
  namespace: agent-platform
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: session-runner-governed
      agentplatform.io/tenant: tenant-test
      agentplatform.io/worker-role: sessions
      agentplatform.io/worker-pool: governed-v1
  policyTypes:
  - Egress
  egress:
  - to:
    - ipBlock:
        cidr: 10.43.0.1/32
    ports:
    - port: 443
      protocol: TCP
  - to:
    - ipBlock:
        cidr: 100.64.0.0/10
    ports:
    - port: 6443
      protocol: TCP
  - to:
    - podSelector:
        matchLabels:
          app.kubernetes.io/name: agent-policy-service
    ports:
    - port: 9002
      protocol: TCP
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: temporal
      podSelector:
        matchLabels:
          app.kubernetes.io/name: temporal-mtls
    ports:
    - port: 7233
      protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: aps-ingress-governed-sessions
  namespace: agent-platform
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: agent-policy-service
  policyTypes:
  - Ingress
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app.kubernetes.io/name: session-runner-governed
          agentplatform.io/tenant: tenant-test
          agentplatform.io/worker-role: sessions
          agentplatform.io/worker-pool: governed-v1
    ports:
    - port: 9002
      protocol: TCP
---
