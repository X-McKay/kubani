# Inactive read-only additions; no finalizer, Pod delete or control write grants.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-generation-control
  namespace: agent-platform
rules:
- apiGroups:
  - ''
  resources:
  - configmaps
  resourceNames:
  - conformance-generation-control
  verbs:
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-generation-control
  namespace: agent-platform
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-generation-control
subjects:
- kind: ServiceAccount
  name: session-runner
  namespace: agent-platform
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-generation-observer
  namespace: tenant-test
rules:
- apiGroups:
  - agentplatform.io
  resources:
  - agentreleases
  resourceNames:
  - ${CONFORMANCE_RELEASE}
  - ${GENERATION_PROBE_RELEASE}
  - ${GENERATION_RECOVERY_RELEASE}
  verbs:
  - get
- apiGroups:
  - ''
  resources:
  - pods
  verbs:
  - get
  - list
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-generation-observer
  namespace: tenant-test
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-generation-observer
subjects:
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
