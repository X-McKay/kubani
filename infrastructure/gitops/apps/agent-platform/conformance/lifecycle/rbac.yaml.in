# Inactive manual template. Render reviewed images/release/run identity explicitly.
# This file is absent from every Kustomization; root owns activation and fault controls.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-lifecycle-control
  namespace: agent-platform
rules:
- apiGroups:
  - ''
  resources:
  - configmaps
  resourceNames:
  - conformance-lifecycle-control
  verbs:
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-lifecycle-control
  namespace: agent-platform
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-lifecycle-control
subjects:
- kind: ServiceAccount
  name: session-runner
  namespace: agent-platform
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-lifecycle-observer
  namespace: agent-platform
rules:
- apiGroups:
  - apps
  resources:
  - deployments
  resourceNames:
  - agent-policy-service
  verbs:
  - get
- apiGroups:
  - ''
  resources:
  - endpoints
  resourceNames:
  - agent-policy-service
  verbs:
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-lifecycle-observer
  namespace: agent-platform
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-lifecycle-observer
subjects:
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-lifecycle-observer
  namespace: tenant-test
rules:
- apiGroups:
  - agentplatform.io
  resources:
  - agents
  resourceNames:
  - conformance-lifecycle
  verbs:
  - get
- apiGroups:
  - agentplatform.io
  resources:
  - agentreleases
  resourceNames:
  - ${LIFECYCLE_RELEASE}
  verbs:
  - get
- apiGroups:
  - ''
  resources:
  - pods
  verbs:
  - get
  - list
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-lifecycle-observer
  namespace: tenant-test
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-lifecycle-observer
subjects:
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
