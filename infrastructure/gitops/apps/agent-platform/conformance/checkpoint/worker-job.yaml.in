# Inactive manual template: render exact reviewed image, release and fresh run ID.
# Never listed by a Kustomization. Both Jobs remain suspended until operator readiness checks.
apiVersion: batch/v1
kind: Job
metadata:
  name: conformance-checkpoint-worker
  namespace: agent-platform
  labels:
    app.kubernetes.io/name: session-runner
    agentplatform.io/tenant: tenant-test
    agentplatform.io/checkpoint-run: ${CHECKPOINT_RUN_ID}
spec:
  suspend: true
  backoffLimit: 0
  activeDeadlineSeconds: 3600
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: session-runner
        app.kubernetes.io/part-of: agent-platform
        agentplatform.io/tenant: tenant-test
        agentplatform.io/checkpoint-run: ${CHECKPOINT_RUN_ID}
    spec:
      serviceAccountName: session-runner
      automountServiceAccountToken: true
      enableServiceLinks: false
      terminationGracePeriodSeconds: 60
      nodeSelector:
        topology.kubani.io/role: database
      securityContext:
        runAsNonRoot: true
        runAsUser: 1600
        runAsGroup: 1600
        fsGroup: 1600
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: runner
        image: ${CHECKPOINT_RUNNER_IMAGE}
        args:
        - --allow-checkpoint-faults
        env:
        - name: TENANT
          value: tenant-test
        - name: APS_URL
          value: http://agent-policy-service.agent-platform.svc.cluster.local:9002
        - name: APS_TOKEN_PATH
          value: /var/run/secrets/agent-policy-service/token
        - name: TEMPORAL_ADDRESS
          value: temporal-mtls.temporal.svc.cluster.local:7233
        - name: TEMPORAL_NAMESPACE
          value: agents-tenant-test
        - name: TEMPORAL_TLS_CERT
          value: /etc/temporal-tls/tls.crt
        - name: TEMPORAL_TLS_KEY
          value: /etc/temporal-tls/tls.key
        - name: TEMPORAL_TLS_CA
          value: /etc/temporal-tls/ca.crt
        - name: PAYLOAD_KEY_FILE
          value: /etc/agent-platform/payload-key/tenant-test
        - name: ARTIFACT_DIR
          value: /var/lib/agent-artifacts
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: '1'
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          runAsNonRoot: true
          readOnlyRootFilesystem: true
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - name: aps-token
          mountPath: /var/run/secrets/agent-policy-service
          readOnly: true
        - name: temporal-tls
          mountPath: /etc/temporal-tls
          readOnly: true
        - name: payload-key
          mountPath: /etc/agent-platform/payload-key
          readOnly: true
        - name: artifacts
          mountPath: /var/lib/agent-artifacts
        - name: tmp
          mountPath: /tmp
        command:
        - /app/.venv/bin/python
        - -m
        - runner.conformance_checkpoint_worker
      volumes:
      - name: aps-token
        projected:
          sources:
          - serviceAccountToken:
              audience: agent-policy-service
              expirationSeconds: 600
              path: token
      - name: temporal-tls
        secret:
          secretName: session-runner-temporal-tls
      - name: payload-key
        secret:
          secretName: session-payload-key-tenant-test
          items:
          - key: key
            path: tenant-test
      - name: tmp
        emptyDir:
          sizeLimit: 256Mi
      - name: artifacts
        persistentVolumeClaim:
          claimName: agent-artifacts-tenant-test
      restartPolicy: Never
