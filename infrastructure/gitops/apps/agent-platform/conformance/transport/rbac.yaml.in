# Inactive T27 manual template; render exact signed releases, image and fresh UUIDs.
# Not listed by a Kustomization. Jobs stay suspended until operator checks complete.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-transport-control
  namespace: agent-platform
rules:
- apiGroups:
  - ''
  resources:
  - configmaps
  resourceNames:
  - conformance-transport-control
  verbs:
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-transport-control
  namespace: agent-platform
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-transport-control
subjects:
- kind: ServiceAccount
  name: session-runner
  namespace: agent-platform
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: conformance-transport-observer
  namespace: tenant-test
rules:
- apiGroups:
  - agentplatform.io
  resources:
  - agentreleases
  resourceNames:
  - ${TRANSPORT_RELEASE}
  - ${T4_RELEASE}
  verbs:
  - get
- apiGroups:
  - ''
  resources:
  - pods
  verbs:
  - list
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: conformance-transport-observer
  namespace: tenant-test
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: conformance-transport-observer
subjects:
- kind: ServiceAccount
  name: conformance-harness
  namespace: agent-platform
