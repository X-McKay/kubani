# Inactive T27 manual template; render exact signed releases, image and fresh UUIDs.
# Not listed by a Kustomization. Jobs stay suspended until operator checks complete.
apiVersion: batch/v1
kind: Job
metadata:
  name: conformance-transport-harness
  namespace: agent-platform
  labels:
    app.kubernetes.io/name: conformance-harness
    app.kubernetes.io/part-of: agent-platform
    agentplatform.io/tenant: tenant-test
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: conformance-harness
        app.kubernetes.io/part-of: agent-platform
        agentplatform.io/tenant: tenant-test
    spec:
      restartPolicy: Never
      serviceAccountName: conformance-harness
      automountServiceAccountToken: true
      enableServiceLinks: false
      nodeSelector:
        topology.kubani.io/role: database
      securityContext:
        runAsNonRoot: true
        runAsUser: 1600
        runAsGroup: 1600
        fsGroup: 1600
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: harness
        image: ${TRANSPORT_RUNNER_IMAGE}
        command:
        - /app/.venv/bin/agent-conformance
        args:
        - --tenant
        - tenant-test
        - --agent
        - conformance
        - --release
        - $(T4_RELEASE)
        - --tests
        - T27
        - --transport-fixture-release
        - $(TRANSPORT_RELEASE)
        - --observe-host-capture
        - --session-timeout
        - '900'
        - --report
        - /tmp/report.json
        env:
        - name: TENANT
          value: tenant-test
        - name: TEMPORAL_ADDRESS
          value: temporal-mtls.temporal.svc.cluster.local:7233
        - name: TEMPORAL_NAMESPACE
          value: agents-tenant-test
        - name: TEMPORAL_TLS_CERT
          value: /etc/temporal-tls/tls.crt
        - name: TEMPORAL_TLS_KEY
          value: /etc/temporal-tls/tls.key
        - name: TEMPORAL_TLS_CA
          value: /etc/temporal-tls/ca.crt
        - name: PAYLOAD_KEY_FILE
          value: /etc/agent-platform/payload-key/tenant-test
        - name: TRANSPORT_RELEASE
          value: ${TRANSPORT_RELEASE}
        - name: ARTIFACT_DIR
          value: /var/lib/agent-artifacts
        - name: T4_RELEASE
          value: ${T4_RELEASE}
        - name: ISSUER_URL
          value: https://idp.almckay.io/realms/agents
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: '1'
            memory: 1Gi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          runAsNonRoot: true
          readOnlyRootFilesystem: true
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - name: temporal-tls
          mountPath: /etc/temporal-tls
          readOnly: true
        - name: payload-key
          mountPath: /etc/agent-platform/payload-key
          readOnly: true
        - name: tmp
          mountPath: /tmp
        - name: artifacts
          mountPath: /var/lib/agent-artifacts
          readOnly: true
      volumes:
      - name: temporal-tls
        secret:
          secretName: conformance-harness-temporal-tls
      - name: payload-key
        secret:
          secretName: session-payload-key-tenant-test
          items:
          - key: key
            path: tenant-test
      - name: tmp
        emptyDir:
          sizeLimit: 256Mi
      - name: artifacts
        persistentVolumeClaim:
          claimName: agent-artifacts-tenant-test
          readOnly: true
  suspend: true
