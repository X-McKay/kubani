{
  "version": 1,
  "clusters": [
    {
      "name": "kubani",
      "trustDomain": "cluster.local",
      "gateway": "http://ai.ai-gateway.svc.cluster.local",
      "fluxInventories": [
        {
          "namespace": "flux-system",
          "name": "apps"
        }
      ]
    }
  ],
  "tenants": [
    {
      "cluster": "kubani",
      "name": "tenant-test",
      "namespace": "tenant-test",
      "policy": {
        "signer": {
          "issuer": "https://token.actions.githubusercontent.com",
          "subjectRegExp": "^https://github\\.com/X-McKay/zetra-agents/\\.github/workflows/release\\.yml@refs/tags/(?:conformance|conformance-b|conformance-budget-day|conformance-budget-day-retry|conformance-budget-day-retry2|conformance-budget-session|conformance-checkpoint|conformance-lifecycle|conformance-performance|conformance-protocol|conformance-transport|db-admin|investigator)/v[0-9][A-Za-z0-9.+-]*$"
        },
        "vulnExceptions": []
      }
    }
  ],
  "trustedRepositories": [
    {
      "repository": "X-McKay/zetra-agents",
      "cluster": "kubani",
      "tenant": "tenant-test",
      "issuer": "https://token.actions.githubusercontent.com",
      "subjectRegExp": "^https://github\\.com/X-McKay/zetra-agents/\\.github/workflows/release\\.yml@refs/tags/(?:conformance|conformance-b|conformance-budget-day|conformance-budget-day-retry|conformance-budget-day-retry2|conformance-budget-session|conformance-checkpoint|conformance-lifecycle|conformance-performance|conformance-protocol|conformance-transport|db-admin|investigator)/v[0-9][A-Za-z0-9.+-]*$",
