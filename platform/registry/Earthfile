VERSION 0.8

# =============================================================================
# Kubani Registry Service Build
# =============================================================================
# Centralized metadata registry for agents, MCP servers, models, and endpoints.
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=v0.1.0       # Build with specific version
#   earthly +test                          # Run tests
#   earthly +lint                          # Run linting
#   earthly --push +push                   # Push to registry
# =============================================================================

# Import from root Earthfile
IMPORT .. AS root

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=kubani-registry
ARG --global VERSION=latest

# =============================================================================
# Dependencies
# =============================================================================

# Install Python dependencies
deps:
    FROM python:3.11-slim

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Create non-root user
    RUN useradd -m -u 1000 registry
    WORKDIR /app

    # Install uv for faster package installation
    RUN pip install --no-cache-dir uv

    # Copy project files for dependency resolution
    COPY pyproject.toml /app/

    # Install dependencies
    RUN uv pip install --system --no-cache -e ".[dev]"

    SAVE IMAGE --cache-hint

# =============================================================================
# Source Code
# =============================================================================

# Copy source code
src:
    FROM +deps

    # Copy source
    COPY --chown=registry:registry src/ /app/src/
    COPY --chown=registry:registry alembic/ /app/alembic/
    COPY --chown=registry:registry alembic.ini /app/

    # Set Python path
    ENV PYTHONPATH=/app/src:/app

    SAVE IMAGE --cache-hint

# =============================================================================
# Testing
# =============================================================================

# Run tests
test:
    FROM +src

    # Copy test files
    COPY --chown=registry:registry tests/ /app/tests/

    # Run pytest with coverage
    RUN pytest \
        --cov=kubani_registry \
        --cov=kubani_registry_mcp \
        --cov-report=term-missing \
        --cov-report=xml:coverage.xml \
        -v || true

    SAVE ARTIFACT coverage.xml AS LOCAL coverage.xml

# Run linting
lint:
    FROM +src

    COPY --chown=registry:registry tests/ /app/tests/

    # Run ruff check
    RUN ruff check src/ || true

    # Run ruff format check
    RUN ruff format --check src/ || true

# =============================================================================
# Docker Image
# =============================================================================

# Build production Docker image
docker:
    FROM python:3.11-slim

    # Install system dependencies for asyncpg
    RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        && rm -rf /var/lib/apt/lists/*

    # Create non-root user
    RUN useradd -m -u 1000 registry
    WORKDIR /app

    # Install uv
    RUN pip install --no-cache-dir uv

    # Copy project files
    COPY --chown=registry:registry pyproject.toml /app/
    COPY --chown=registry:registry README.md /app/

    # Copy source
    COPY --chown=registry:registry src/ /app/src/
    COPY --chown=registry:registry alembic/ /app/alembic/
    COPY --chown=registry:registry alembic.ini /app/

    # Install production dependencies only
    RUN uv pip install --system --no-cache .

    # Set environment
    ENV PYTHONPATH=/app/src:/app

    # Switch to non-root user
    USER registry

    # Expose port
    EXPOSE 8000

    # Entry point - run the FastAPI service
    ENTRYPOINT ["python", "-m", "kubani_registry.main"]

    # Build metadata
    LABEL org.opencontainers.image.title="kubani-registry"
    LABEL org.opencontainers.image.description="Centralized registry for Kubani agents and services"
    LABEL org.opencontainers.image.version="${VERSION}"
    LABEL org.opencontainers.image.source="https://github.com/X-McKay/kubani"

    # Save image
    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# Push to registry
push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Database Migrations
# =============================================================================

# Run database migrations
migrate:
    FROM +src
    # Expects REGISTRY_DATABASE_URL environment variable
    RUN --no-cache alembic upgrade head

# Generate a new migration
migration:
    ARG MESSAGE="auto migration"
    FROM +src
    RUN alembic revision --autogenerate -m "${MESSAGE}"
    SAVE ARTIFACT alembic/versions/*.py AS LOCAL alembic/versions/

# =============================================================================
# Development Helpers
# =============================================================================

# Interactive shell for development
dev:
    FROM +src
    COPY --chown=registry:registry tests/ /app/tests/
    RUN --interactive /bin/bash

# Run the service locally
run:
    FROM +docker
    RUN --entrypoint python -m kubani_registry.main
