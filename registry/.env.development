# Kubani Registry Service - Development Environment
# =================================================
# Copy this file to .env to run the registry service locally.
#
# Prerequisites:
#   - Connected to Tailscale network
#   - DNS resolves *.almckay.io to cluster
#   - kubani_registry database exists in PostgreSQL
#
# Usage:
#   cp .env.development .env
#   uv run registry-service

# =============================================================================
# Database (PostgreSQL via Tailscale)
# =============================================================================
REGISTRY_DATABASE_URL=postgresql://kubani:kubani@postgres.almckay.io:5432/kubani_registry  # pragma: allowlist secret
REGISTRY_DATABASE_ECHO=false

# =============================================================================
# Cache (Redis via Tailscale)
# =============================================================================
REGISTRY_REDIS_URL=redis://redis.almckay.io:6379

# =============================================================================
# Server
# =============================================================================
REGISTRY_HOST=0.0.0.0
REGISTRY_PORT=8000

# =============================================================================
# Heartbeat & Health Checking
# =============================================================================
# Agent heartbeat timeout (seconds) - mark as unhealthy after this
REGISTRY_HEARTBEAT_TIMEOUT_SECONDS=90
# How often to check for stale heartbeats (seconds)
REGISTRY_HEARTBEAT_CHECK_INTERVAL=30
# Endpoint health check interval (seconds)
REGISTRY_HEALTH_CHECK_INTERVAL=60
# Timeout for health check HTTP requests (seconds)
REGISTRY_HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# Logging
# =============================================================================
REGISTRY_LOG_LEVEL=DEBUG
