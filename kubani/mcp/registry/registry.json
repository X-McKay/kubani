{
  "version": "1.0",
  "servers": {
    "cloudflare-docs": {
      "name": "cloudflare-docs-mcp",
      "description": "Search Cloudflare documentation",
      "transport": "sse",
      "url": "https://docs.cloudflare.com/mcp/sse",
      "capabilities": [
        "docs.search"
      ],
      "readOnly": true
    },
    "discord": {
      "name": "discord-mcp-server",
      "description": "Bidirectional Discord integration for AI agents - send/read messages, manage reactions, channels, and webhooks",
      "transport": "sse",
      "url": "https://discord-mcp.almckay.io/sse",
      "capabilities": [
        "messages.send",
        "messages.read",
        "messages.delete",
        "messages.await_reply",
        "reactions.add",
        "reactions.remove",
        "reactions.get",
        "reactions.await",
        "channels.list",
        "channels.create",
        "channels.delete",
        "webhooks.list",
        "webhooks.create",
        "webhooks.delete"
      ],
      "readOnly": false
    },
    "kubernetes": {
      "name": "kubernetes-mcp-server",
      "description": "Native Kubernetes operations via MCP protocol",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@anthropics/kubernetes-mcp-server@latest"
      ],
      "env": {
        "KUBECONFIG": "/etc/kubernetes/kubeconfig"
      },
      "capabilities": [
        "pods.list",
        "pods.get",
        "pods.logs",
        "pods.exec",
        "pods.delete",
        "deployments.list",
        "deployments.scale",
        "events.list",
        "namespaces.list",
        "resources.get",
        "resources.create",
        "resources.delete",
        "helm.install",
        "helm.list",
        "helm.uninstall"
      ],
      "namespaces": [
        "*"
      ],
      "readOnly": false
    }
  },
  "policies": {
    "default": {
      "allowedServers": [
        "kubernetes",
        "cloudflare-docs",
        "discord"
      ],
      "requireApproval": [
        "pods.delete",
        "deployments.scale",
        "resources.delete",
        "channels.delete",
        "webhooks.delete"
      ],
      "auditLog": true
    },
    "k8s-monitor": {
      "allowedServers": [
        "kubernetes",
        "discord"
      ],
      "requireApproval": [
        "pods.delete",
        "channels.delete"
      ],
      "auditLog": true,
      "namespaceRestrictions": {
        "deny": [
          "kube-system",
          "flux-system"
        ]
      }
    },
    "security-monitor": {
      "allowedServers": [
        "kubernetes"
      ],
      "requireApproval": [
        "*"
      ],
      "auditLog": true,
      "readOnly": true
    }
  }
}
