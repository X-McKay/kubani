VERSION 0.8

# =============================================================================
# Memory MCP Server Build
# =============================================================================
# Unified MCP server for Kubani memory system (Qdrant + Neo4j + Redis)
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=0.2.1        # Build with specific version
#   earthly --push +push --VERSION=0.2.1   # Build and push to registry
# =============================================================================

# Import from kubani root
IMPORT ../../../.. AS root
IMPORT ../../.. AS kubani

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=memory-mcp-server
ARG --global VERSION=latest

# =============================================================================
# Docker Image
# =============================================================================

docker:
    FROM python:3.11-slim

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Create non-root user
    RUN useradd -m -s /bin/bash appuser
    WORKDIR /app

    # Install uv system-wide
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
        mv /root/.local/bin/uv /usr/local/bin/uv && \
        mv /root/.local/bin/uvx /usr/local/bin/uvx
    ENV PATH="/usr/local/bin:$PATH"

    # Copy workspace root files
    COPY root+root-files/pyproject.toml /app/pyproject.toml
    COPY root+root-files/README.md /app/README.md

    # Copy kubani package (framework)
    COPY kubani+src/__init__.py /app/kubani/__init__.py
    COPY kubani+src/framework /app/kubani/framework
    COPY kubani+src/agents /app/kubani/agents

    # Create MCP servers directory structure
    RUN mkdir -p /app/kubani/mcp/servers/memory

    # Copy this MCP server
    COPY pyproject.toml /app/kubani/mcp/servers/memory/pyproject.toml
    COPY README.md /app/kubani/mcp/servers/memory/README.md
    COPY src /app/kubani/mcp/servers/memory/src

    # Update workspace to include this MCP server
    RUN python3 -c "
import re
with open('/app/pyproject.toml', 'r') as f:
    content = f.read()
# Replace the members list with just this MCP server
content = re.sub(
    r'(\[tool\.uv\.workspace\])\s*members\s*=\s*\[[^\]]*\]',
    r'\1\nmembers = [\"kubani/mcp/servers/memory\"]',
    content
)
with open('/app/pyproject.toml', 'w') as f:
    f.write(content)
"

    # Install dependencies
    RUN uv sync --package memory-mcp-server --no-dev

    # Set ownership
    RUN chown -R appuser:appuser /app

    # Switch to non-root user
    USER appuser

    EXPOSE 8083

    ENTRYPOINT ["uv", "run", "--package", "memory-mcp-server", "memory-mcp"]
    CMD ["--mode", "sse", "--port", "8083"]

    # Labels
    LABEL org.opencontainers.image.title="memory-mcp-server"
    LABEL org.opencontainers.image.description="Memory MCP server for Kubani"
    LABEL org.opencontainers.image.version="${VERSION}"

    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Push
# =============================================================================

push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END
