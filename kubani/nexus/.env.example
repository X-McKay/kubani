# Nexus Local Development Environment
# =====================================
# Copy to .env and adjust values. These point to cluster services
# via Tailscale/egress for local development.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your credentials
#   source .env
#   python -m kubani.nexus.orchestrator.worker

# Temporal workflow engine
TEMPORAL_HOST=temporal.almckay.io:7233
TEMPORAL_NAMESPACE=nexus

# PostgreSQL (Nexus state)
# NEXUS_DATABASE_URL=postgresql://nexus:<password>@postgres.almckay.io:5432/nexus

# Redis (pub/sub, caching)
REDIS_URL=redis://redis.almckay.io:6379

# LLM (vLLM)
LLM_API_URL=https://llm.almckay.io/v1

# VLM (uses same vLLM instance as LLM - Qwen3.5 is multimodal)
VLM_API_URL=https://llm.almckay.io/v1
VLM_MODEL=Qwen3.5-9B-NVFP4

# Vector database
QDRANT_URL=https://qdrant.almckay.io
# QDRANT_API_KEY=

# Graph database
NEO4J_URI=bolt://neo4j.almckay.io:7687
# NEO4J_PASSWORD=

# MCP servers
MCP_MEMORY_URL=http://memory-mcp.almckay.io:8083
MCP_SKILLS_URL=http://skills-mcp.almckay.io:8085

# Discord (optional, for Discord bridge testing)
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_USER_ID=

# Logging
LOG_LEVEL=INFO
