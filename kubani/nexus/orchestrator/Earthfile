VERSION 0.8

# =============================================================================
# Nexus Orchestrator Build
# =============================================================================
# Temporal worker that runs the Strands-based agentic loop for Nexus.
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=0.6.4        # Build with specific version
#   earthly --push +push                   # Push to registry
# =============================================================================

# Import from kubani root for shared sources
IMPORT ../.. AS kubani

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=kubani-nexus-orchestrator
ARG --global VERSION=latest

# =============================================================================
# Docker Image
# =============================================================================

docker:
    FROM python:3.12-slim
    WORKDIR /app

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Install Node.js via mise (needed by mcp-server-fetch for Readability.js)
    ENV MISE_DATA_DIR="/opt/mise"
    RUN curl https://mise.run | sh \
        && /root/.local/bin/mise install node@lts \
        && /root/.local/bin/mise use --global node@lts
    ENV PATH="/opt/mise/shims:$PATH"

    # Copy workspace root for installable package
    COPY kubani+src/pyproject.toml /app/pyproject.toml
    COPY kubani+src/README.md /app/README.md

    # Copy kubani package (framework, agents, nexus)
    COPY kubani+src/__init__.py /app/kubani/__init__.py
    COPY kubani+src/framework /app/kubani/framework
    COPY kubani+src/agents /app/kubani/agents
    COPY kubani+src/nexus /app/kubani/nexus

    # Install the kubani package with needed extras + orchestrator runtime deps
    RUN pip install --no-cache-dir -e ".[events,skills]" \
        && pip install --no-cache-dir asyncpg duckduckgo-search mcp-server-fetch

    # Run as non-root user
    RUN useradd -m -u 1000 appuser
    USER appuser

    CMD ["python", "-m", "kubani.nexus.orchestrator.worker"]

    # Labels
    LABEL org.opencontainers.image.title="kubani-nexus-orchestrator"
    LABEL org.opencontainers.image.description="Nexus orchestrator - Temporal worker with Strands agentic loop"
    LABEL org.opencontainers.image.version="${VERSION}"

    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Push
# =============================================================================

push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END
