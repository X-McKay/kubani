FROM python:3.12-slim

WORKDIR /app

# Install runtime dependencies directly (standalone service, not the full kubani package)
RUN pip install --no-cache-dir \
    "discord.py>=2.3.0" \
    "httpx>=0.27.0" \
    "redis>=5.0.0"

# Copy only the listener script
COPY kubani/nexus/gateway/discord_listener.py discord_listener.py

# Run as non-root user
RUN useradd -m -u 1000 appuser
USER appuser

CMD ["python", "discord_listener.py"]
