VERSION 0.8

# =============================================================================
# Kubani Framework Build
# =============================================================================
# Shared framework, agents, and base classes for Kubani syndicates
#
# Usage:
#   earthly +src                           # Export source files
#   earthly +wheel                         # Build wheel
#   earthly +test                          # Run framework tests
# =============================================================================

# Import from project root for root-level files
IMPORT .. AS root

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global VERSION=latest

# =============================================================================
# Source Export (for syndicate builds)
# =============================================================================

src:
    FROM scratch

    # Export framework source files (pyproject.toml and README.md from project root)
    COPY root+root-files/pyproject.toml /pyproject.toml
    COPY root+root-files/README.md /README.md
    COPY __init__.py /__init__.py
    COPY framework /framework
    COPY agents /agents
    COPY skills /skills
    COPY nexus /nexus

    SAVE ARTIFACT /pyproject.toml pyproject.toml
    SAVE ARTIFACT /README.md README.md
    SAVE ARTIFACT /__init__.py __init__.py
    SAVE ARTIFACT /framework framework
    SAVE ARTIFACT /agents agents
    SAVE ARTIFACT /skills skills
    SAVE ARTIFACT /nexus nexus

    # Config directory from project root
    COPY root+root-files/config /config
    SAVE ARTIFACT /config config

# =============================================================================
# Python Base
# =============================================================================

python-base:
    FROM python:3.11-slim

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Install uv
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh
    ENV PATH="/root/.local/bin:$PATH"

    WORKDIR /app

    SAVE IMAGE --cache-hint

# =============================================================================
# Dependencies
# =============================================================================

deps:
    FROM +python-base

    # Copy project files
    COPY pyproject.toml /app/pyproject.toml
    COPY framework /app/framework
    COPY agents /app/agents

    # Sync dependencies (framework only, no workspace)
    RUN uv sync --no-dev

    SAVE IMAGE --cache-hint

# =============================================================================
# Testing
# =============================================================================

test:
    FROM +deps

    # Install dev dependencies
    RUN uv sync

    # Copy syndicate code for tests
    COPY syndicates /app/syndicates

    # Run tests
    RUN uv run pytest framework/ agents/ syndicates/ -v

# =============================================================================
# Wheel Build
# =============================================================================

wheel:
    FROM +deps

    # Build wheel
    RUN uv build --wheel

    SAVE ARTIFACT dist/*.whl /wheel/
