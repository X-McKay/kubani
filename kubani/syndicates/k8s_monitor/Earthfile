VERSION 0.8

# =============================================================================
# K8s Monitor Syndicate Build
# =============================================================================
# Kubernetes cluster health monitoring syndicate with Temporal workflows
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=0.5.0        # Build with specific version
#   earthly +test                          # Run tests
#   earthly --push +push                   # Push to registry
# =============================================================================

# Import from kubani root
IMPORT ../.. AS kubani

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=k8s-monitor
ARG --global VERSION=latest

# =============================================================================
# Dependencies
# =============================================================================

deps:
    FROM python:3.11-slim

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Install uv system-wide (accessible to all users)
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
        mv /root/.local/bin/uv /usr/local/bin/uv && \
        mv /root/.local/bin/uvx /usr/local/bin/uvx
    ENV PATH="/usr/local/bin:$PATH"

    # Create non-root user
    RUN useradd -m -s /bin/bash agent
    WORKDIR /app

    # Copy workspace root files
    COPY kubani+src/pyproject.toml /app/pyproject.toml
    COPY kubani+src/README.md /app/README.md

    # Copy kubani package (framework, agents)
    COPY kubani+src/__init__.py /app/kubani/__init__.py
    COPY kubani+src/framework /app/kubani/framework
    COPY kubani+src/agents /app/kubani/agents
    # Create syndicates __init__.py
    RUN mkdir -p /app/kubani/syndicates && echo '"""Kubani syndicates package."""' > /app/kubani/syndicates/__init__.py

    # Copy this syndicate (workflow-based architecture)
    COPY pyproject.toml /app/kubani/syndicates/k8s_monitor/pyproject.toml
    COPY src /app/kubani/syndicates/k8s_monitor/src
    COPY __init__.py /app/kubani/syndicates/k8s_monitor/__init__.py
    COPY workflows /app/kubani/syndicates/k8s_monitor/workflows
    COPY config.yaml /app/kubani/syndicates/k8s_monitor/config.yaml

    # Update workspace config to only include this syndicate
    # Remove other workspace members (keep k8s_monitor)
    RUN sed -i 's|"kubani/syndicates/news_digest",||' /app/pyproject.toml && \
        sed -i 's|"platform/cli",||' /app/pyproject.toml

    # Sync dependencies
    RUN uv sync --package k8s-monitor-syndicate

    SAVE IMAGE --cache-hint

# =============================================================================
# Testing
# =============================================================================

test:
    FROM +deps

    # Copy tests
    COPY tests /app/kubani/syndicates/k8s_monitor/tests

    # Run tests
    RUN uv run --package k8s-monitor-syndicate pytest -v

# =============================================================================
# Docker Image
# =============================================================================

docker:
    FROM python:3.11-slim

    # Install runtime dependencies only
    RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Create non-root user
    RUN useradd -m -s /bin/bash agent
    WORKDIR /app

    # Install uv system-wide (accessible to all users including 'agent')
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
        mv /root/.local/bin/uv /usr/local/bin/uv && \
        mv /root/.local/bin/uvx /usr/local/bin/uvx
    ENV PATH="/usr/local/bin:$PATH"

    # Copy workspace files from kubani root
    COPY kubani+src/pyproject.toml /app/pyproject.toml
    COPY kubani+src/README.md /app/README.md

    # Copy kubani package (framework, agents)
    COPY kubani+src/__init__.py /app/kubani/__init__.py
    COPY kubani+src/framework /app/kubani/framework
    COPY kubani+src/agents /app/kubani/agents
    # Create syndicates __init__.py
    RUN mkdir -p /app/kubani/syndicates && echo '"""Kubani syndicates package."""' > /app/kubani/syndicates/__init__.py

    # Copy this syndicate (workflow-based architecture)
    COPY pyproject.toml /app/kubani/syndicates/k8s_monitor/pyproject.toml
    COPY src /app/kubani/syndicates/k8s_monitor/src
    COPY __init__.py /app/kubani/syndicates/k8s_monitor/__init__.py
    COPY workflows /app/kubani/syndicates/k8s_monitor/workflows
    COPY config.yaml /app/kubani/syndicates/k8s_monitor/config.yaml

    # Update workspace config to only include this syndicate
    # Remove other workspace members (keep k8s_monitor)
    RUN sed -i 's|"kubani/syndicates/news_digest",||' /app/pyproject.toml && \
        sed -i 's|"platform/cli",||' /app/pyproject.toml

    # Install production dependencies
    RUN uv sync --package k8s-monitor-syndicate --no-dev

    # Set ownership
    RUN chown -R agent:agent /app

    # Switch to non-root user
    USER agent

    # Verify uv is accessible
    RUN uv --version

    # Entry point - runs the Temporal worker
    ENTRYPOINT ["uv", "run", "--package", "k8s-monitor-syndicate", "k8s-monitor-worker"]

    # Labels
    LABEL org.opencontainers.image.title="k8s-monitor"
    LABEL org.opencontainers.image.description="Kubernetes cluster health monitoring syndicate with Temporal workflows"
    LABEL org.opencontainers.image.version="${VERSION}"

    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Push
# =============================================================================

push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END
