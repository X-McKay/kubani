VERSION 0.8

# =============================================================================
# News Digest Syndicate Build
# =============================================================================
# News aggregation and digest generation syndicate
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=0.2.0        # Build with specific version
#   earthly +test                          # Run tests
#   earthly --push +push                   # Push to registry
# =============================================================================

# Import from kubani root
IMPORT ../.. AS kubani

# Arguments
ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=news-monitor
ARG --global VERSION=latest

# =============================================================================
# Dependencies
# =============================================================================

deps:
    FROM python:3.11-slim

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Install uv
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh
    ENV PATH="/root/.local/bin:$PATH"

    # Create non-root user
    RUN useradd -m -s /bin/bash agent
    WORKDIR /app

    # Copy workspace root files
    COPY kubani+src/pyproject.toml /app/pyproject.toml
    COPY kubani+src/README.md /app/README.md

    # Copy framework and agents (part of kubani-framework)
    COPY kubani+src/framework /app/framework
    COPY kubani+src/agents /app/agents
    COPY kubani+src/syndicates/_base /app/syndicates/_base

    # Copy this syndicate (include syndicate definition and config)
    COPY pyproject.toml /app/syndicates/news_digest/pyproject.toml
    COPY src /app/syndicates/news_digest/src
    COPY __init__.py /app/syndicates/news_digest/__init__.py
    COPY syndicate.py /app/syndicates/news_digest/syndicate.py
    COPY config.yaml /app/syndicates/news_digest/config.yaml

    # Update workspace config to only include this syndicate
    RUN sed -i 's/members = \["syndicates\/k8s_monitor", "syndicates\/news_digest"\]/members = ["syndicates\/news_digest"]/' /app/pyproject.toml

    # Sync dependencies
    RUN uv sync --package news-digest-syndicate

    SAVE IMAGE --cache-hint

# =============================================================================
# Testing
# =============================================================================

test:
    FROM +deps

    # Copy tests
    COPY tests /app/syndicates/news_digest/tests

    # Run tests
    RUN uv run --package news-digest-syndicate pytest -v

# =============================================================================
# Docker Image
# =============================================================================

docker:
    FROM python:3.11-slim

    # Install runtime dependencies only
    RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        && rm -rf /var/lib/apt/lists/*

    # Create non-root user BEFORE installing uv
    RUN useradd -m -s /bin/bash agent
    WORKDIR /app

    # Install uv system-wide (accessible to all users)
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --install-dir /usr/local/bin
    ENV PATH="/usr/local/bin:$PATH"

    # Copy workspace files from kubani root
    COPY kubani+src/pyproject.toml /app/pyproject.toml
    COPY kubani+src/README.md /app/README.md

    # Copy framework and agents
    COPY kubani+src/framework /app/framework
    COPY kubani+src/agents /app/agents
    COPY kubani+src/syndicates/_base /app/syndicates/_base

    # Copy this syndicate (include syndicate definition and config)
    COPY pyproject.toml /app/syndicates/news_digest/pyproject.toml
    COPY src /app/syndicates/news_digest/src
    COPY __init__.py /app/syndicates/news_digest/__init__.py
    COPY syndicate.py /app/syndicates/news_digest/syndicate.py
    COPY config.yaml /app/syndicates/news_digest/config.yaml

    # Update workspace config to only include this syndicate
    RUN sed -i 's/members = \["syndicates\/k8s_monitor", "syndicates\/news_digest"\]/members = ["syndicates\/news_digest"]/' /app/pyproject.toml

    # Install production dependencies
    RUN uv sync --package news-digest-syndicate --no-dev

    # Set ownership
    RUN chown -R agent:agent /app

    # Switch to non-root user
    USER agent

    # Verify uv is accessible
    RUN uv --version

    # Entry point
    ENTRYPOINT ["uv", "run", "--package", "news-digest-syndicate", "news-digest-worker"]

    # Labels
    LABEL org.opencontainers.image.title="news-monitor"
    LABEL org.opencontainers.image.description="News aggregation and digest generation syndicate"
    LABEL org.opencontainers.image.version="${VERSION}"

    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Push
# =============================================================================

push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END
