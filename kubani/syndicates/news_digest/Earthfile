VERSION 0.8

# =============================================================================
# News Digest Syndicate Build (Simplified)
# =============================================================================
# News aggregation and digest generation syndicate with Temporal workflows
#
# Usage:
#   earthly +docker                        # Build Docker image (latest)
#   earthly +docker --VERSION=0.5.0        # Build with specific version
#   earthly +test                          # Run tests
#   earthly --push +push                   # Push to registry
# =============================================================================

IMPORT ../.. AS kubani

ARG --global REGISTRY=registry.almckay.io
ARG --global IMAGE_NAME=news-monitor
ARG --global VERSION=latest

# =============================================================================
# Shared Setup (deduplicated base for deps and docker)
# =============================================================================

setup:
    ARG INCLUDE_GIT=false
    FROM python:3.12-slim

    # Install system dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        $(if [ "$INCLUDE_GIT" = "true" ]; then echo "git"; fi) \
        && rm -rf /var/lib/apt/lists/*

    # Install uv system-wide (accessible to all users)
    RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
        mv /root/.local/bin/uv /usr/local/bin/uv && \
        mv /root/.local/bin/uvx /usr/local/bin/uvx
    ENV PATH="/usr/local/bin:$PATH"

    # Create non-root user
    RUN useradd -m -s /bin/bash agent
    WORKDIR /app

    # Copy workspace root files
    COPY kubani+src/pyproject.toml /app/pyproject.toml
    COPY kubani+src/README.md /app/README.md

    # Copy kubani package (framework, agents)
    COPY kubani+src/__init__.py /app/kubani/__init__.py
    COPY kubani+src/framework /app/kubani/framework
    COPY kubani+src/agents /app/kubani/agents
    RUN mkdir -p /app/kubani/syndicates && echo '"""Kubani syndicates package."""' > /app/kubani/syndicates/__init__.py

    # Copy this syndicate
    COPY pyproject.toml /app/kubani/syndicates/news_digest/pyproject.toml
    COPY src /app/kubani/syndicates/news_digest/src
    COPY __init__.py /app/kubani/syndicates/news_digest/__init__.py
    COPY workflows /app/kubani/syndicates/news_digest/workflows
    COPY config.yaml /app/kubani/syndicates/news_digest/config.yaml

    # Update workspace config to only include this syndicate
    RUN sed -i 's|"kubani/syndicates/k8s_monitor",||' /app/pyproject.toml

# =============================================================================
# Dependencies (for testing)
# =============================================================================

deps:
    FROM +setup --INCLUDE_GIT=true
    RUN uv sync --package news-digest-syndicate
    SAVE IMAGE --cache-hint

# =============================================================================
# Testing
# =============================================================================

test:
    FROM +deps
    COPY tests /app/kubani/syndicates/news_digest/tests
    RUN uv run --package news-digest-syndicate pytest -v -o "addopts=" kubani/syndicates/news_digest/tests

# =============================================================================
# Docker Image
# =============================================================================

docker:
    FROM +setup

    # Install production dependencies
    # Pre-install build backends to avoid concurrent PyPI fetch timeout in buildkit
    RUN uv pip install --system hatchling setuptools
    RUN uv sync --package news-digest-syndicate --no-dev

    # Set ownership and switch to non-root user
    RUN chown -R agent:agent /app
    USER agent

    # Set HOME for uv to find the venv properly
    ENV HOME=/app

    # Verify uv is accessible
    RUN uv --version

    # Entry point - runs the Temporal worker
    ENTRYPOINT ["uv", "run", "--package", "news-digest-syndicate", "news-digest-worker"]

    # Labels
    LABEL org.opencontainers.image.title="news-monitor"
    LABEL org.opencontainers.image.description="News aggregation and digest generation syndicate with Temporal workflows"
    LABEL org.opencontainers.image.version="${VERSION}"

    SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE ${REGISTRY}/${IMAGE_NAME}:latest
    END

# =============================================================================
# Push
# =============================================================================

push:
    FROM +docker
    SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
    IF [ "${VERSION}" != "latest" ]
        SAVE IMAGE --push ${REGISTRY}/${IMAGE_NAME}:latest
    END
