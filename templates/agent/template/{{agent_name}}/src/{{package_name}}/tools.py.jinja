{% if uses_kubernetes %}

@tool
def get_cluster_info() -> dict[str, Any]:
    """
    Get basic information about the Kubernetes cluster.

    Returns:
        Dictionary with cluster information.
    """
    _load_k8s_config()
    v1 = client.CoreV1Api()

    nodes = v1.list_node()
    namespaces = v1.list_namespace()

    return {
        "node_count": len(nodes.items),
        "nodes": [node.metadata.name for node in nodes.items],
        "namespace_count": len(namespaces.items),
        "namespaces": [ns.metadata.name for ns in namespaces.items],
    }
{% endif %}


# Export all tools for the agent
ALL_TOOLS = [
    example_tool,
{% if uses_kubernetes %}
    get_cluster_info,
{% endif %}
]
