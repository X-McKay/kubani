"""
Data models for {{ agent_name }}.
"""

from enum import Enum
from typing import Any

from pydantic import BaseModel, Field


class Status(str, Enum):
    """Status enum for {{ agent_name }} results."""

    HEALTHY = "healthy"
    WARNING = "warning"
    CRITICAL = "critical"
    ERROR = "error"


class Result(BaseModel):
    """Result from {{ agent_name }} analysis."""

    model_config = {"frozen": True}

    summary: str = Field(description="Summary of the analysis")
    status: Status = Field(description="Overall status")
    timestamp: str = Field(description="ISO format timestamp")
    details: dict[str, Any] = Field(default_factory=dict, description="Additional details")
    error: str | None = Field(default=None, description="Error message if failed")
{% if uses_discord %}


class DiscordPostResult(BaseModel):
    """Result of posting to Discord."""

    model_config = {"frozen": True}

    success: bool = Field(description="Whether the post succeeded")
    message_id: str | None = Field(default=None, description="Discord message ID")
    error: str | None = Field(default=None, description="Error message if failed")
{% endif %}
