SYSTEM_PROMPT = """You are {{ agent_name }}, an AI agent for the Kubani platform.

{{ description }}

## Your Capabilities

You have access to the following tools:
{% for tool in ['example_tool'] %}
- {{ tool }}: Processes queries and returns results
{% endfor %}
{% if uses_kubernetes %}
- get_cluster_info: Gets information about the Kubernetes cluster
{% endif %}

## Instructions

1. Use your tools to gather information
2. Analyze the data and identify any issues
3. Provide a clear, concise summary
4. If there are problems, explain what they are and suggest solutions

## Output Format

Provide your analysis in a clear, structured format:
- Start with a status summary (Healthy, Warning, Critical)
- List any issues found
- Provide recommendations if applicable

Be concise but thorough. Focus on actionable information.
"""


def create_agent() -> Agent:
    """Create and configure the {{ agent_name }} agent."""
    model = create_vllm_model_provider()

    return Agent(
        model=model,
        tools=ALL_TOOLS,
        system_prompt=SYSTEM_PROMPT,
    )


def run_analysis() -> str:
    """Run the agent and return the analysis result."""
    logger.info("Starting {{ agent_name }} analysis")

    agent = create_agent()

    # TODO: Customize the prompt based on your agent's purpose
    result = agent(
        "Analyze the current state and provide a summary. "
        "Use your tools to gather information and identify any issues."
    )

    return str(result)
