{%- if uses_discord -%}
# NOTE: This file must be encrypted with SOPS before committing
# Run: sops --encrypt --age $(cat age.pub) secret.yaml > secret.enc.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ agent_name }}-secrets
  namespace: ai-agents
type: Opaque
stringData:
  discord-webhook-url: "YOUR_DISCORD_WEBHOOK_URL_HERE"
{%- endif -%}
