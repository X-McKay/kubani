---
extends: default

ignore: |
  *.enc.yaml
  **/*.enc.yaml
  infrastructure/gitops/apps/starbase/rendered.yaml
  infrastructure/gitops/flux-system/gotk-components.yaml

rules:
  braces: disable
  comments:
    min-spaces-from-content: 1
  document-start: disable
  indentation: disable
  line-length:
    max: 160
